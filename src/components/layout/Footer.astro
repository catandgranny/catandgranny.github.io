---
/**
 * Footer.astro — site footer with grouped links and the fan-site disclosure
 * that keeps the site honest about who owns the game.
 */
import { SITE, GAME_OFFICIAL_URL, GAME_DEVELOPER_URL } from '../../config/site';
import { getLangFromUrl, useTranslations, localizedHref } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const columns = [
  {
    title: t('footer.game'),
    links: [
      { label: t('nav.home'), href: localizedHref(lang, '/') },
      { label: t('nav.howToPlay'), href: localizedHref(lang, '/how-to-play/') },
      { label: t('nav.controls'), href: localizedHref(lang, '/controls/') },
    ],
  },
  {
    title: t('footer.guides'),
    links: [
      { label: t('nav.tips'), href: localizedHref(lang, '/tips/') },
      { label: t('nav.unblocked'), href: localizedHref(lang, '/unblocked/') },
      { label: t('nav.about'), href: localizedHref(lang, '/about/') },
    ],
  },
  {
    title: t('footer.site'),
    links: [
      { label: t('footer.privacy'), href: localizedHref(lang, '/privacy/') },
      { label: t('footer.terms'), href: localizedHref(lang, '/terms/') },
      {
        label: 'GitHub',
        href: 'https://github.com/catandgranny/catandgranny.github.io',
        external: true,
      },
    ],
  },
];
---

<footer class="mt-24 border-t border-[var(--border)] bg-[var(--bg-secondary)]">
  <div class="mx-auto max-w-6xl px-4 py-14 md:px-6">
    <div class="grid gap-10 md:grid-cols-[1.6fr_repeat(3,1fr)]">
      <div>
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-8 w-8 items-center justify-center rounded-xl bg-[var(--color-primary-600)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="white"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4.5 w-4.5"
              aria-hidden="true"
            >
              <path d="M4.5 10.5 5.2 4l4.3 3h5l4.3-3 .7 6.5v4.6a5.4 5.4 0 0 1-5.4 5.4h-4.2a5.4 5.4 0 0 1-5.4-5.4z" />
              <path d="M9.3 12.4h.01M14.7 12.4h.01" />
            </svg>
          </span>
          <span class="font-display text-base font-bold tracking-tight">
            Cat and Granny<span class="text-[var(--color-accent-400)]"> Online</span>
          </span>
        </div>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-[var(--text-secondary)]">
          {t('footer.aboutText')}
        </p>
        <p class="mt-4 max-w-sm text-xs leading-relaxed text-[var(--text-tertiary)]">
          {t('footer.credit')}
        </p>
        <p class="mt-2 max-w-sm text-xs leading-relaxed text-[var(--text-tertiary)]">
          {t('footer.official')}
          <a
            href={GAME_OFFICIAL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-[var(--text-secondary)] underline decoration-dotted underline-offset-2 hover:text-[var(--text-primary)]"
          >
            Playgama
          </a>
          ·
          <a
            href={GAME_DEVELOPER_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-[var(--text-secondary)] underline decoration-dotted underline-offset-2 hover:text-[var(--text-primary)]"
          >
            {SITE.author}
          </a>
        </p>
      </div>

      {columns.map((column) => (
        <div>
          <h2 class="text-xs font-semibold tracking-wider text-[var(--text-primary)] uppercase">
            {column.title}
          </h2>
          <ul class="mt-4 space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-[var(--text-tertiary)] transition-colors hover:text-[var(--text-primary)]"
                  {...('external' in link && link.external
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-[var(--border)] pt-6 text-xs text-[var(--text-tertiary)] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {SITE.name}. {t('footer.rights')}</p>
      <p>
        {t('footer.builtWith')} ·
        <a
          href={GAME_DEVELOPER_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="underline decoration-dotted underline-offset-2 hover:text-[var(--text-primary)]"
        >
          Cat and Granny by {SITE.author}
        </a>
      </p>
    </div>
  </div>
</footer>
